{% extends 'submissions/_base.html.twig' %}
{% from 'shared_parts/shared_macros.html.twig' import pagination %}

{% block title %}Submissions{% endblock %}

{% block body %}
    {% if is_granted('ROLE_ADMIN') %}
        <a class="btn btn-outline-primary float-end" href="{{ path('rt_submissions_social') }}">Post on social</a>
    {% endif %}

    <div class="d-flex flex-row-reverse justify-content-between align-items-center">
        <span><button class="btn btn-sm btn-outline-secondary"  type="button" data-bs-toggle="collapse" data-bs-target="#subm-act-container" aria-expanded="false" aria-controls="subm-act-container">Toggle activity</button></span>
        <h1>{{ block('title') }}</h1>
    </div>

    <div id="subm-act-container" class="collapse pb-3">
        <ul class="nav nav-underline" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="subm-act-normal-tab" data-bs-toggle="tab" data-bs-target="#subm-act-normal-pane"
                        type="button" role="tab" aria-controls="subm-act-normal-pane" aria-selected="true">Normal
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="subm-act-markdown-tab" data-bs-toggle="tab" data-bs-target="#subm-act-markdown-pane"
                        type="button" role="tab" aria-controls="subm-act-markdown-pane" aria-selected="false">Markdown
                </button>
            </li>
        </ul>
        <div class="tab-content p-2">
            <div class="tab-pane fade show active" id="subm-act-normal-pane" role="tabpanel" aria-labelledby="subm-act-normal-tab" tabindex="0">
                {% for day, submission_summaries in summaries %}
                    <p class="mb-1">On {{ day }}:</p>
                    <ul class="mb-1">
                        {% for summary in submission_summaries %}
                            <li>
                                {{ summary.nicknames }} posted/updated {{ summary.count }} message(s) in <a class="text-decoration-none" href="{{ path('rt_submission_review', {id: summary.submissionId}) }}">#{{ summary.submissionId }}</a>
                            </li>
                        {% endfor %}
                    </ul>
                {% endfor %}
            </div>
            <div class="tab-pane fade" id="subm-act-markdown-pane" role="tabpanel" aria-labelledby="subm-act-markdown-tab" tabindex="0">
                {% for day, submission_summaries in summaries %}
                    <div class="user-select-all">
                        On {{ day }}:<br>
                        {% for summary in submission_summaries %}
                            - {{ summary.nicknames }} posted/updated {{ summary.count }} message(s) in [#{{ summary.submissionId }}]({{ url('rt_submission_review', {id: summary.submissionId}) }})<br>
                        {% endfor %}
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>

    {% if filter_form !== null %}
        {{ form_errors(filter_form) }}
        {{ form_start(filter_form) }}
        <div class="row">
            <div class="col">
                {{ form_row(filter_form.statuses) }}
            </div>
            <div class="col">
                {{ form_row(filter_form.update) }}

                <button type="submit" class="btn btn-outline-primary">Apply</button>
            </div>
        </div>
        {{ form_end(filter_form) }}
    {% endif %}

    <div class="table-responsive">
        <table class="table table-sm">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Submitted at</th>
                    <th>Type</th>
                    <th>Maker ID | Maker name</th>
                    {% if is_granted('ROLE_ADMIN') %}
                        <th>Status</th>
                    {% endif %}
                    <th>Comments</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for submission in submissions_page.items %}
                    <tr>
                        <td class="text-nowrap">{{ submission.id }}</td>
                        <td class="text-nowrap">{{ submission.submittedAtUtc|fragile_datetime_utc }}</td>
                        <td>
                            {%- if submission.isUpdate -%}
                                <span class="badge {{ submission.status.isActionRequired ? 'text-bg-warning' : 'bg-secondary-subtle text-secondary-emphasis' }}">Update</span>
                            {%- else -%}
                                <span class="badge {{ submission.status.isActionRequired ? 'text-bg-success' : 'bg-secondary-subtle text-secondary-emphasis' }}">Inclusion</span>
                            {%- endif -%}
                        </td>
                        <td>
                            <span class="font-monospace">{{ submission.reader.get('MAKER_ID'|as_field) }}</span> | {{ submission.reader.get('NAME'|as_field) }}
                        </td>
                        {% if is_granted('ROLE_ADMIN') %}
                            <td>{{ submission.status.label }}</td>
                        {% endif %}
                        <td>{{ submission.comment|nl2br }}</td>
                        <td>
                            {% if is_granted('ROLE_ADMIN') %}
                                <a class="text-decoration-none" href="{{ path('rt_submission_manage', {id: submission.id}) }}">
                                    Manage
                                </a>
                                |
                            {% endif %}

                            <a class="text-decoration-none" href="{{ path('rt_submission_review', {id: submission.id}) }}">
                                Review

                                {% if unread_counts.getOrDefaultOf(submission.id, 0) %}
                                    <span class="badge text-bg-primary">{{ unread_counts.get(submission.id) }}</span>
                                {% endif %}
                            </a>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    {{ pagination(submissions_page, path('rt_submissions_list', {page: '1'}), 'submissions') }}
{% endblock %}
