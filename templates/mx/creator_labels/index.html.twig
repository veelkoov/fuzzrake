{% extends '_base.html.twig' %}

{% block title %}{{ creator.name }} [{{ creator.lastCreatorId }}] - labels{% endblock %}

{% block body %}
    <h1>{{ block('title') }}</h1>

    <table class="table mb-5">
        <thead>
            <tr>
                <th>Type</th>
                <th>Value</th>
                <th>Comment</th>
                <th>Added on</th>
                <th>Active since</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            {% for label in labels %}
                <tr>
                    <td>{{ label.type.value }}</td>
                    <td>{{ label.value | nl2br }}</td>
                    <td>{{ label.comment | nl2br }}</td>
                    <td>{{ label.addedAtUtc | nullable_datetime_utc }}</td>
                    <td>{{ label.active ? label.activatedAtUtc | nullable_datetime_utc : 'Not active' }}</td>
                    <td><a href="{{ path('rt_mx_creator_label_edit', {creatorId: creator.lastCreatorId, labelId: label.id}) }}">Edit</a></td>
                </tr>
            {% endfor %}
        </tbody>
    </table>

    {{ form_start(new_label_form) }}
    <div class="row">
        <div class="col">
            {{ form_row(new_label_form.type) }}
            {{ form_row(new_label_form.active) }}
        </div>
        <div class="col">
            {{ form_row(new_label_form.value) }}
        </div>
        <div class="col">
            {{ form_row(new_label_form.comment) }}
        </div>
    </div>
    <div class="row">
        <div class="col">
            {{ form_row(new_label_form.save) }}
        </div>
    </div>
    {{ form_end(new_label_form) }}
{% endblock %}
