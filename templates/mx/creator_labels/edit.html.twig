{% extends '_base.html.twig' %}

{% block title %}{{ creator.name }} [{{ creator.lastCreatorId }}] - label #{{ label.id }}{% endblock %}

{% block body %}
    <h1>{{ block('title') }}</h1>

    {{ form_start(form) }}
    <div class="row">
        <div class="col">
            {{ form_row(form.type) }}
            {{ form_row(form.active) }}
        </div>
        <div class="col">
            {{ form_row(form.value) }}
        </div>
        <div class="col">
            {{ form_row(form.comment) }}
        </div>
    </div>
    <div class="row">
        <div class="col">
            {{ form_row(form.save) }}
        </div>
        <div class="col text-end">
            {{ form_row(form.delete) }}
        </div>
    </div>
    {{ form_end(form) }}
{% endblock %}
