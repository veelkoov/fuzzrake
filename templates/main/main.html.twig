{% extends '_base.html.twig' %}

{% block javascripts %}
    {{ parent() }}

    {{ encore_entry_script_tags('main') }}
    {{ encore_entry_script_tags('creator_card') }}
{% endblock %}

{% block stylesheets %}
    {{ parent() }}

    {{ encore_entry_link_tags('main') }}
    {{ encore_entry_link_tags('creator_card') }}
{% endblock %}

{% block body %}
    <div id="loading-indicator" class="htmx-indicator">
        <div class="alert alert-light text-primary border-primary-subtle shadow" role="alert">
            <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
            <span role="status">Loading...</span>
        </div>
    </div>
    {{ include('main/parts/htmx_events.html.twig') }}
    {{ include('main/parts/filters.html.twig') }}

    {{ include('main/parts/intro.html.twig') }}
    {{ include('shared_parts/adding_studios_on_hold.html.twig') }}

    {{ include('main/parts/checklist.html.twig') }}

    <div id="creator-mode-banner" class="card border-danger mb-3 d-none">
        <div class="card-header">
            Filters disabled
        </div>
        <div class="card-body">
            <p class="card-text">
                All filtering has been temporarily disabled to ease searching the whole database. Use the below button to restore them.
            </p>
            <a id="btn-reenable-filters" href="{{ path('rt_main') }}" class="btn btn-light btn-outline-danger">Re-enable filters</a>
        </div>
    </div>

    <div class="offcanvas offcanvas-start" tabindex="-1" id="pref-fltr-offcanvas" aria-labelledby="pref-fltr-offcanvas-label">
        <div class="offcanvas-header">
            <h4 class="offcanvas-title" id="pref-fltr-offcanvas-label">Preferences</h4>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>

        <div class="offcanvas-body">
            <h5>Always shown</h5>

            {% for column_id, col_label in {
                photos: 'Photos',
                'creator-id': 'Maker ID',
                state: 'State',
                languages: 'Languages',
                'production-models': 'Production models',
                styles: 'Styles',
                types: 'Types',
                features: 'Features',
                species: 'Species',
                commissions: 'Commissions',
                links: 'Links',
                'allergy-warning': 'Allergy warning',
            } %}
                <div class="form-check">
                    <input class="form-check-input colvis" type="checkbox" value="{{ column_id }}" id="checkbox-{{ column_id }}">
                    <label class="form-check-label" for="checkbox-{{ column_id }}">
                        {{ col_label }}
                    </label>
                </div>
            {% endfor %}
        </div>
    </div>

    <div class="main-primary-content d-none">
        <div class="row">
            <div class="col">
                <input id="search-text-field" class="my-1" type="text" name="textSearch" placeholder="Search">

                <button class="btn btn-sm btn-dark" type="button" data-bs-toggle="offcanvas" data-bs-target="#pref-fltr-offcanvas" aria-controls="pref-fltr-offcanvas">
                    Preferences
                </button>

                <button id="open-filters-button" type="button" class="btn btn-sm btn-success text-nowrap" data-bs-toggle="modal" data-bs-target="#filters-modal">
                    Filters <span id="active-filters-count" class="badge rounded-pill text-bg-light"></span>
                </button>
            </div>
        </div>

        <div id="main-creators-list" class="row"></div>
    </div>

    <div class="main-primary-content d-none">
        <div id="main-creators-pagination"></div>
    </div>
{% endblock %}
