{% macro based_in(state, city) %}
    {% set text = [state, city]|filter(i => i)|join(', ') %}

    {% if text %}
        {{ text -}}
    {% else %}
        {# Providing location is voluntary. TODO: Require state for US and Canada #}
    {% endif %}
{% endmacro %}

{% macro crafting_since(input) %}
    {% set months = {
        '01': 'Jan',
        '02': 'Feb',
        '03': 'Mar',
        '04': 'Apr',
        '05': 'May',
        '06': 'Jun',
        '07': 'Jul',
        '08': 'Aug',
        '09': 'Sep',
        10: 'Oct',
        11: 'Nov',
        12: 'Dec',
    } %}

    {% if input %}
        {% set parts = input|split('-') %}

        {{ months[parts[1]] }} {{ parts[0] }}
    {% else %}
        {{ unknown_value() }}
    {%- endif -%}
{% endmacro %}

{% macro list_cs_opt(items) %}
    {% if items %}
        {% for item in items %} ‣&nbsp;{{ item }} {% endfor %}
    {% else %}
        {{ unknown_value() }}
    {% endif %}
{% endmacro %}

{% macro list_with_others_comment_opt(items, other_items = [], comment = '') %}
    {% if comment %}
        <span class="nl2br">{{ comment }}</span>
    {% endif %}

    {% if items or other_items %}
        <ul>
            {% for item in items %}
                <li>{{ item }}</li>
            {% endfor %}

            {% if other_items %}
                <li>{{ other_items|join('; ') }}</li>
            {% endif %}
        </ul>
    {% else %}
        {{ unknown_value() }}
    {% endif %}
{% endmacro %}

{% macro link(uri, label, icon_class, additional_button_class = '') %}
    {% if uri %}
        <a class="{{ additional_button_class }} p-1" href="{{ uri }}" target="_blank">
            <i class="{{ icon_class }}"></i> {{ label }}
        </a>
    {% endif %}
{% endmacro %}

<div class="row">
    <div class="col">
        {{ creator.name }}
    </div>
    <div class="col">
        <span class="fi fi-{{ creator.country|lower }}"></span>
        {{ _self.based_in(creator.state, creator.city) }}<br>
        <small>
            Speaking: {{ _self.list_cs_opt(creator.languages) }}
        </small>
    </div>
    <div class="col">
        <small>Crafting since {{ _self.crafting_since(creator.since) }}</small>
    </div>
    <div class="col">
        {% if creator.creatorId %}
            <a href="{{ url('rt_creator', {creatorId: creator.creatorId}) }}">
                <span class="badge bg-secondary"><i class="fas fa-link"></i> {{ creator.creatorId -}}</span>
            </a>
        {% endif %}
    </div>
    {# FIXME: Must not be cached/served to anonymoous #}
    {% if is_granted('ROLE_ADMIN') %}
        <div class="col">
            <a class="btn btn-warning" href="{{ path('rt_mx_creator_edit', {creatorId: creator.lastCreatorId}) }}"
               role="button">
                <i class="fas fa-edit"></i>
            </a>

            <a class="btn btn-warning"
               href="{{ path('rt_mx_creator_urls_selection', {creatorId: creator.lastCreatorId}) }}" role="button">
                <i class="fas fa-link"></i>
            </a>
        </div>
    {% endif %}
</div>

{% if creator.formerly %}
    <div class="row">
        <div class="col">
            <small>Formerly/a.k.a. {{ _self.list_cs_opt(creator.formerly) }}</small>
        </div>
    </div>
{% endif %}

<div class="row">
    <div class="col">
        Last update: {{ creator.lastUpdateDateTime|nullable_datetime_utc }}
    </div>
    <div class="col">
        <div class="dropdown">
            <button class="btn btn-light border-warning dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                Data outdated/inaccurate?
            </button>
            <ul class="dropdown-menu">
                <li>
                    <a class="dropdown-item" href="{{ path('rt_iu_form_step_start', {creatorId: creator.lastCreatorId}) }}">
                        Send updates as the maker
                    </a>
                </li>
                <li>
                    <a class="dropdown-item" href="{{ path('rt_feedback_form', {creator: creator.lastCreatorId}) }}" {# grep-creator-query-parameter #} target="_blank">
                        Submit the feedback form
                    </a>
                </li>
            </ul>
        </div>
    </div>
</div>

{% if creator.inactiveReason %}
    <div class="row">
        <div class="col">
            <strong>This maker has been hidden for the following reason:</strong><br>
            {{ creator.inactiveReason }}
        </div>
    </div>
{% endif %}

{% if creator.hasValidPhotos %}
    <div class="row">
        <div class="col overflow-auto imgs-container">
            {% for photo_url in creator.photoUrls %}
                <div>
                    <a href="{{ photo_url }}" target="_blank"><img src="{{ creator.miniatureUrls[loop.index0] }}" alt=""></a>
                </div>
            {% endfor %}
        </div>
    </div>
{% endif %}

{% if creator.intro %}
    <div class="row">
        <div class="col">
            <p class="lead nl2br">
                {{- creator.intro -}}
            </p>
        </div>
    </div>
{% endif %}

<div class="row">
    <div class="col">
        <strong>
            {% if creator.hasAllergyWarning is null %}
                {% if '' == creator.allergyWarningInfo %}
                    No information for allergic customers
                    {{ unknown_value() }}
                {% else %}
                    Allergy warning
                    {{ unknown_value() }}
                {% endif %}
            {% elseif creator.hasAllergyWarning %}
                Allergy warning
                <i class="text-warning fa-solid fa-triangle-exclamation"></i>
            {% else %}
                No allergy warning
                <i class="text-success fa-solid fa-circle-xmark"></i>
            {% endif %}
        </strong>

        {% if '' != creator.allergyWarningInfo %}
            {{ creator.allergyWarningInfo|nl2br }}
        {% elseif creator.hasAllergyWarning %}
            Please check the provided links for details or contact the maker regarding this matter.
        {% endif %}
    </div>

    <div class="col">
        Ages of studio members: {{ ages_description(creator, true) }}
    </div>
</div>

<div class="d-flex flex-wrap">
    <div class="look-ma-am-box">
        <h5>Produces</h5>

        <div class="small pb-2">
            {{ _self.list_with_others_comment_opt(creator.productionModels, [], creator.productionModelsComment) }}
        </div>
    </div>

    <div class="look-ma-am-box">
        <h5>Styles</h5>

        <div class="small">
            {{ _self.list_with_others_comment_opt(creator.styles, creator.otherStyles, creator.stylesComment) }}
        </div>
    </div>

    <div class="look-ma-am-box" style="flex-grow: 2">
        <h5>Types</h5>

        <div class="small">
            {{ _self.list_with_others_comment_opt(creator.orderTypes, creator.otherOrderTypes, creator.orderTypesComment) }}
        </div>
    </div>

    <div class="look-ma-am-box" style="flex-grow: 2">
        <h5>Features</h5>

        <div class="small">
            {{ _self.list_with_others_comment_opt(creator.features, creator.otherFeatures, creator.featuresComment) }}
        </div>
    </div>

    <div class="look-ma-am-box">
        <h5>Species</h5>

        <div class="small pb-2">
            {% if creator.speciesComment %}
                <span class="nl2br">{{ creator.speciesComment }}</span><br>
            {% endif %}

            {% if creator.speciesDoes %}
                <strong>Does</strong>: {{ _self.list_cs_opt(creator.speciesDoes) }}
                {% if creator.speciesDoesnt %}<br>{% endif %}
            {% endif %}

            {% if creator.speciesDoesnt %}
                <strong>Doesn't</strong>: {{ _self.list_cs_opt(creator.speciesDoesnt) }}
            {% endif %}

            {% if not creator.speciesDoes and not creator.speciesDoesnt %}
                {{ unknown_value() }}
            {% endif %}
        </div>
    </div>

    <div class="look-ma-am-box">
        <h5>Payment plans {{ nullable_boolean_symbol(creator.offersPaymentPlans) }}</h5>

        {% if creator.paymentPlansInfo %}
            <div class="small pb-2">
                <span class="nl2br">{{ creator.paymentPlansInfo }}</span>
            </div>
        {% endif %}
    </div>

    <div class="look-ma-am-box">
        <h5>Prices in*</h5>

        <div class="small pb-2">
            {{ _self.list_cs_opt(creator.currenciesAccepted) }}
        </div>
    </div>

    <div class="look-ma-am-box">
        <h5>Accepted payments</h5>

        <div class="small">
            {{ _self.list_cs_opt(creator.paymentMethods) }}
        </div>
    </div>

    <div class="look-ma-am-box">
        <h5>Commissions status</h5>

        {% if not creator.isTracked %}
            <p>
                Commissions status is not being tracked.

                <small>
                    <a href="{{ path('rt_tracking') }}" target="_blank">Learn more about automatic tracking.</a>
                </small>
            </p>
        {% elseif creator.isStatusKnown %}
            {% if creator.csTrackerIssue %}
                <p>
                    <small>
                        <i class="inaccurate fas fa-question-circle"></i>
                        Note: the software encountered apparent difficulties while figuring out the status;
                        the information is most probably inaccurate/<wbr>incomplete.
                    </small>
                </p>
            {% endif %}

            <table class="table table-sm table-striped table-borderless">
                <tbody>
                {% for item in creator.openFor %}
                    <tr>
                        <td>{{ item }}</td>
                        <td><i class="fas fa-check-square"></i>&nbsp;Open</td>
                    </tr>
                {% endfor %}
                {% for item in creator.closedFor %}
                    <tr>
                        <td>{{ item }}</td>
                        <td><i class="fas fa-times-circle"></i>&nbsp;Closed</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>

            <p>
                <small>
                    Status is tracked and updated automatically based on the contents of:
                    {% for uri in creator.commissionsUrls %}
                        <a href="{{ uri }}" target="_blank">{{ uri }}</a>
                        {%- if not loop.last %},{% endif %}
                    {%- endfor %}.
                    Last time checked on {{ creator.csLastCheck|nullable_datetime_utc }}.

                    <a href="{{ path('rt_tracking') }}" target="_blank">Learn more about automatic tracking.</a>
                </small>
            </p>
        {% else %}
            <p>
                <i class="inaccurate fas fa-question-circle"></i> Failed to automatically determine commissions status.

                <small>
                    It should be tracked and updated automatically based on the contents of:
                    {% for uri in creator.commissionsUrls %}
                        <a href="{{ uri }}" target="_blank">{{ uri }}</a>,
                    {% endfor %}
                    however the software failed to "understand" the contents.
                    Last time tried on {{ creator.csLastCheck|nullable_datetime_utc }}.
                    <a href="{{ path('rt_tracking') }}" target="_blank">Learn more about automatic tracking.</a>
                </small>
            </p>
        {% endif %}
    </div>

</div>

